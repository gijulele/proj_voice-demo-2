# ============================================================
# .env.example — 설정 템플릿 (커밋됨. 실제 값은 넣지 말 것)
#
# 사용법: 이 파일을 .env.local 로 복사한 뒤 빈 값을 채운다.
#         cp .env.example .env.local
# ============================================================

# Supabase 프로젝트 주소 (API 용)
NEXT_PUBLIC_SUPABASE_URL=https://<프로젝트ref>.supabase.co

# anon key — Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------
# DB 직접 접속 (supabase/rls_test.mjs — 터미널 RLS 검증용)
#   프로젝트 생성 시 정한 "데이터베이스 비밀번호".
#   로그인 비밀번호와 다르다. Project Settings > Database 에서 재설정 가능.
# ------------------------------------------------------------
SUPABASE_DB_PASSWORD=

# IPv6 미지원 환경에서만 필요 (Session pooler 호스트)
# SUPABASE_DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com

# 접속 문자열을 통째로 쓰는 경우 (위 두 줄 대신)
# DATABASE_URL=postgresql://postgres.<ref>:<비밀번호>@<호스트>:5432/postgres
