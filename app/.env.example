# ============================================================
# app/.env.example — Next.js 앱 환경변수 템플릿 (커밋됨)
#
# 사용법: 이 파일을 같은 폴더에 .env.local 로 복사한 뒤 값을 채운다.
#         cd app && cp .env.example .env.local
#
# ⚠️ 저장소 루트의 .env.local 과 별개다.
#    Next.js 는 자기 프로젝트 루트(app/)의 .env.local 만 읽는다.
#    루트 쪽은 supabase/ RLS 검증 스크립트용이다.
#
# ⚠️ NEXT_PUBLIC_ 값은 브라우저 번들에 그대로 실린다.
#    service_role 키나 DB 비밀번호는 절대 여기에 넣지 말 것.
# ============================================================

# Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<프로젝트ref>.supabase.co

# Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=
